{
  "name": "openroll",
  "productName": "OpenRoll",
  "version": "0.1.0",
  "private": true,
  "description": "A free, open source video editor for macOS, Windows and Linux.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/noah-thing/openroll",
  "author": "Noah",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "node scripts/fetch-ffmpeg.mjs && npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "node scripts/fetch-ffmpeg.mjs --os mac && npm run build && electron-builder --mac",
    "dist:win": "node scripts/fetch-ffmpeg.mjs --target win-x64 && npm run build && electron-builder --win",
    "dist:win-arm64": "npm run build && electron-builder --win nsis --arm64",
    "dist:linux": "node scripts/fetch-ffmpeg.mjs --target linux-x64 && npm run build && electron-builder --linux --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@jitsi/rnnoise-wasm": "0.2.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "kokoro-js": "1.2.1",
    "mediabunny": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "desktopName": "openroll.desktop"
}
